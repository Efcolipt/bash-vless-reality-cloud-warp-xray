{
  "log": {
    "level": "debug",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "address": "8.8.8.8",
        "strategy": "prefer_ipv4",
        "tag": "remote",
        "detour": "proxy"
      },
      {
        "address": "77.88.8.8",
        "strategy": "prefer_ipv4",
        "tag": "local",
        "detour": "direct"
      },
      {
        "address": "77.88.8.8",
        "tag": "local_local",
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "server": "local_local",
        "domain": [
          "jocofuz.com"
        ]
      },
      {
        "server": "remote",
        "clash_mode": "Global"
      },
      {
        "server": "local_local",
        "clash_mode": "Direct"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "socks",
      "listen": "127.0.0.1",
      "listen_port": 10808
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singboxer_tun",
      "address": [
        "172.19.0.1/28"
      ],
      "mtu": 1500,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "endpoint_independent_nat": true,
      "sniff": false
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "local_local",
      "strategy": "ipv4_only"
    },
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "port": [
          53
        ],
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "outbound": "direct",
        "clash_mode": "Direct"
      },
      {
        "outbound": "proxy",
        "clash_mode": "Global"
      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "action": "reject"
      },
      {
        "outbound": "proxy",
        "domain": [
          "habr.com"
        ]
      },
      {
        "outbound": "direct",
        "ip_is_private": true,
        "rule_set": [
          "geoip-private"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geoip-ru"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-private",
          "geosite-category-ru"
        ]
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/refs/heads/release/sing-box/rule-set-geosite/geosite-category-ads-all.srs",
        "download_detour": "direct",
        "update_interval": "6h"
      },
      {
        "tag": "geosite-private",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/refs/heads/release/sing-box/rule-set-geosite/geosite-private.srs",
        "download_detour": "direct",
        "update_interval": "6h"
      },
      {
        "tag": "geosite-category-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/refs/heads/release/sing-box/rule-set-geosite/geosite-category-ru.srs",
        "download_detour": "direct",
        "update_interval": "6h"
      },
      {
        "tag": "geoip-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/refs/heads/release/sing-box/rule-set-geoip/geoip-ru.srs",
        "download_detour": "direct",
        "update_interval": "6h"
      },
      {
        "tag": "geoip-private",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/refs/heads/release/sing-box/rule-set-geoip/geoip-private.srs",
        "download_detour": "direct",
        "update_interval": "6h"
      }
    ],
    "final": "proxy"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:10814"
    }
  }
}