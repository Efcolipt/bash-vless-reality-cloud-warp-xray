services:
  caddy:
    image: $CADDY_IMAGE
    container_name: caddy
    restart: always
    network_mode: host
    volumes:
      - ./caddy/data:/data
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile
      - ./caddy/templates:/srv

  xray:
    image: $XRAY_IMAGE
    user: root
    command: run -c /etc/xray/config.json
    container_name: xray
    restart: always
    network_mode: host
    volumes:
      - ./xray:/etc/xray
      - ./geodata:/usr/local/share/xray/