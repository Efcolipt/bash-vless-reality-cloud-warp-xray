{
    https_port $CADDY_PORT
    default_bind 127.0.0.1

    servers {
        protocols h1 h2
        listener_wrappers {
            tls
        }
    }

    auto_https disable_redirects
}

https://$SERVER_DOMAIN {
    root * /srv
    file_server

    header {
        -Server
    }

    handle_errors {
        header {
            -Server
        }
    }
}

http://$SERVER_DOMAIN {
    bind 0.0.0.0
    redir https://$SERVER_DOMAIN{uri} permanent
}

:80 {
    bind 0.0.0.0
    respond 204
}
