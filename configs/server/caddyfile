{
        https_port $CADDY_PORT
        default_bind 127.0.0.1
        servers {
                listener_wrappers {
                        proxy_protocol {
                                allow 127.0.0.1/32
                        }
                        tls
                }
        }
        auto_https disable_redirects
}
https://$SERVER_DOMAIN {
        root * /srv
        file_server
}
http://$SERVER_DOMAIN {
        bind 0.0.0.0
        redir https://$SERVER_DOMAIN{uri} permanent
}
:$CADDY_PORT {
        tls internal
        respond 204
}
:80 {
        bind 0.0.0.0
        respond 204
}